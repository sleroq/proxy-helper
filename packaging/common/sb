#!/bin/sh
for arg do
    case "$arg" in
        --config|--config=*|-config|-config=*) exec /usr/lib/sb/sb "$@" ;;
    esac
done
case "${1-}" in
    refresh)
        [ "$#" -eq 1 ] || { echo 'usage: sb refresh' >&2; exit 2; }
        if [ -d /run/systemd/system ]; then
            exec systemctl start sb-proxy-update.service
        fi
        exec sv restart sb-proxy-update
        ;;
    ''|init|version|help|--help|-h) exec /usr/lib/sb/sb "$@" ;;
esac
exec /usr/lib/sb/sb --config /etc/sb/config.json "$@"
