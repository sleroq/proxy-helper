#!/bin/sh
set -e
/usr/lib/ph/initialize
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable ph-proxy.service ph-proxy-update.timer
    systemctl start ph-proxy-update.timer
    if systemctl is-active --quiet ph-proxy.service; then
        systemctl restart ph-proxy.service
    fi
fi
