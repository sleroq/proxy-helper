#!/bin/sh
set -e
case "$1" in
    post)
        /usr/lib/ph/initialize
        /usr/lib/ph/log-initialize
        if [ -d /var/service ] && pgrep -x runsvdir >/dev/null; then
            for service in ph-proxy ph-proxy-update; do
                if [ ! -e "/var/service/$service" ]; then
                    ln -s "/etc/sv/$service" "/var/service/$service"
                elif [ "$service" = ph-proxy ]; then
                    sv restart ph-proxy
                fi
            done
        fi
        ;;
esac
